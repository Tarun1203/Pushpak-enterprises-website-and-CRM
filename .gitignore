# CRM app — internal staff tool, not part of the public brand sites.
# Ignored going forward so future changes/new files under crm/ don't
# get committed by accident. Note: crm/ files already committed in
# this repo's history stay tracked and live on GitHub Pages until
# explicitly removed (git rm --cached) — see chat for why that's a
# separate, deliberate step.
crm/

# Cloud Functions dependencies (installed locally / by the deploy)
functions/node_modules/

# Server secrets for the functions (e.g. MSG91_AUTHKEY). Never commit.
functions/.env
functions/.env.*
!functions/.env.example

# QA tooling dependencies (root package.json)
/node_modules/

QA-tests/.qa-catalog/auth.local.json
QA-tests/.qa-catalog/state/

# Local test output (screenshots, videos, reports)
/qa-results/

# Local QA My App run output and Playwright scratch output
/QA-tests/results/
/test-results/

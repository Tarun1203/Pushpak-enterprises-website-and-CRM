{
  "name": "pushpak-enterprises-website-qa",
  "private": true,
  "version": "1.0.0",
  "description": "Automated browser and site QA for Pushpak Enterprises Website and CRM",
  "scripts": {
    "test:e2e": "playwright test",
    "test:qa": "playwright test --reporter=line,json",
    "qa:report": "node scripts/publish-qa-results.mjs",
    "test:unit": "node --import ./tests/unit/setup.mjs --test \"tests/unit/**/*.test.mjs\"",
    "test:unit:ci": "mkdir -p qa-results/json && node --import ./tests/unit/setup.mjs --test --test-reporter=spec --test-reporter-destination=stdout --test-reporter=./scripts/qa/node-json-reporter.mjs --test-reporter-destination=qa-results/json/frontend_qa.json \"tests/unit/**/*.test.mjs\""
  },
  "devDependencies": {
    "@playwright/test": "^1.55.0",
    "acorn": "^8.19.0",
    "acorn-walk": "^8.3.5",
    "linkedom": "^0.18.13"
  }
}

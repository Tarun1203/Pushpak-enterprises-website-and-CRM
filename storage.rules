rules_version = '2';

service firebase.storage {
  match /b/{bucket}/o {

    // ---------------------------------------------------------------
    // Diagnosis photos (before/after repair shots), one folder per
    // service job. Scoped to signed-in CRM users only — every role
    // in this app is internal staff of some kind (technician,
    // service center, warehouse, super admin); there's no public
    // upload path here. This is the first Storage rule in the
    // project — previously Storage access was left disabled
    // entirely for uploads (see the earlier invoice-attachment
    // field, still disabled on the public site).
    // ---------------------------------------------------------------

    match /serviceJobs/{jobId}/diagnosis/{allPaths=**} {
      allow read: if request.auth != null;
      allow write: if request.auth != null
        && request.resource.size < 10 * 1024 * 1024
        && request.resource.contentType.matches('image/.*');
    }

    // Deny everything else by default.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}

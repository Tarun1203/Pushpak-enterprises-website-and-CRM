rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    // ---------------------------------------------------------------
    // Helper functions
    // ---------------------------------------------------------------

    // Anyone with a Firebase sign-in, customers included. Customers
    // (the public portal, role 'customer') sign themselves up, so this
    // must NOT be what grants CRM access — see isSignedIn() below.
    function hasAuth() {
      return request.auth != null;
    }

    // A signed-in CRM user: staff, dealer or distributor — everything
    // except a self-registered customer. Almost every rule in this file
    // gates on this, so a customer account can never act as staff just
    // by existing. Customer access is granted explicitly by isCustomer()
    // on the few collections they may read.
    function isSignedIn() {
      return request.auth != null && callerRole() != 'customer';
    }

    function isCustomer() {
      return request.auth != null && callerRole() == 'customer';
    }

    // The customer's verified phone, written onto their profile by the
    // ensureCustomerProfile function (never by the browser).
    function myPhone() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.phone10;
    }

    // Looks up the caller's role from their own user profile doc.
    // Every authenticated CRM user must have a corresponding
    // /users/{uid} document with a `role` field for this to work.
    function callerRole() {
      return get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role;
    }

    function isAdmin() {
      return isSignedIn() && callerRole() in ['superadmin', 'warehouse'];
    }

    // Narrower than isAdmin() — Warehouse is deliberately treated as
    // admin-tier for operational data (inventory, claims, products,
    // etc.) everywhere else in this file, but account provisioning
    // for the 'superadmin' role itself must stay Super-Admin-only.
    function isSuperAdmin() {
      return isSignedIn() && callerRole() == 'superadmin';
    }

    function isStaff() {
      // Any recognized internal role — used where dealers/technicians
      // should NOT have access but any office/field staff role should.
      return isSignedIn() && callerRole() in
        ['superadmin', 'warehouse', 'servicecenter', 'technician'];
    }

    function isDistributor() {
      return isSignedIn() && callerRole() == 'distributor';
    }

    // Dealer / distributor orders (see functions/tradePricing.js).
    // The seller steps an order forward one status at a time; it can only
    // be approved ('confirmed') once the server has priced every line.
    // Prices, GST, totals and the status history are server-only.
    function orderStepOk(from, to) {
      return (from == 'placed' && to in ['confirmed', 'rejected', 'cancelled'])
        || (from == 'confirmed' && to in ['dispatched', 'cancelled'])
        || (from == 'dispatched' && to == 'delivered');
    }
    // creditBuyer: the account whose credit is checked when Head Office
    // approves ('' for orders a distributor sells, which have no credit
    // control here).
    function sellerOrderUpdateOk(creditBuyer) {
      let changed = request.resource.data.diff(resource.data).affectedKeys();
      return changed.hasOnly(['status', 'updatedAt', 'statusNote', 'dispatch', 'repriceRequestedAt', 'creditOverride', 'dispatchRequest', 'stockRecheckAt'])
        // Asking the server to dispatch (with one serial per unit) or to
        // re-check stock is only possible while the order is approved.
        && (!changed.hasAny(['dispatchRequest', 'stockRecheckAt'])
            || (resource.data.status == 'confirmed' && request.resource.data.status == 'confirmed'
                && (!changed.hasAny(['dispatchRequest'])
                    || (request.resource.data.dispatchRequest.byUid == request.auth.uid
                        && request.resource.data.dispatchRequest.serials is map
                        && request.resource.data.dispatchRequest.requestedAt == request.time))))
        && ((request.resource.data.status == resource.data.status
              && !changed.hasAny(['creditOverride'])
              && (!changed.hasAny(['repriceRequestedAt']) || resource.data.status == 'placed'))
            || (orderStepOk(resource.data.status, request.resource.data.status)
                // A priced order is marked dispatched only by the server,
                // after it has checked every serial (processDispatch).
                && (request.resource.data.status != 'dispatched' || !('lines' in resource.data))
                && (request.resource.data.status != 'confirmed'
                    || !('lines' in resource.data)
                    || (resource.data.get('pricing', {}).get('status', '') == 'ok'
                        && (creditBuyer == '' || approvalCreditOk(creditBuyer))))));
    }
    // Approving a priced Head Office order: the buyer must stay within its
    // credit limit and have no overdue invoice (tradeAccounts is kept up to
    // date by the invoice/payment functions), unless Super Admin overrides
    // with a written reason.
    function approvalCreditOk(buyerUid) {
      let acctPath = /databases/$(database)/documents/tradeAccounts/$(buyerUid);
      return (isSuperAdmin() && request.resource.data.get('creditOverride', false) == true
              && request.resource.data.get('statusNote', '') is string
              && request.resource.data.get('statusNote', '').size() >= 5)
        || (request.resource.data.get('creditOverride', false) == false
            && exists(acctPath)
            && get(acctPath).data.get('outstanding', 0) + resource.data.totals.total <= get(acctPath).data.get('creditLimit', 0)
            && (get(acctPath).data.get('oldestUnpaidDue', null) == null || get(acctPath).data.oldestUnpaidDue > request.time));
    }
    function buyerCancelOk() {
      return resource.data.status == 'placed' && request.resource.data.status == 'cancelled'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'statusNote']);
    }
    function newOrderLinesOk() {
      return request.resource.data.lines is list
        && request.resource.data.lines.size() >= 1 && request.resource.data.lines.size() <= 50
        && request.resource.data.get('notes', '') is string && request.resource.data.get('notes', '').size() <= 1000
        && request.resource.data.status == 'placed'
        && request.resource.data.createdAt == request.time;
    }

    // ---------------------------------------------------------------
    // Public website content — readable by anyone, writable only
    // by Super Admin / Warehouse via the CRM's Website Management.
    // ---------------------------------------------------------------

    match /siteContent/{docId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /brands/{brandId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // Contact enquiries from the public landing page form.
    // Anyone can submit one; only admins can read or manage them
    // (surfaces in CRM > Website Management > Contact Enquiries).
    // ---------------------------------------------------------------

    // ---------------------------------------------------------------
    // Serial-number counters backing ticket/request/part IDs:
    //   counters/enquiry-{YYYYMM}, counters/sparerequest-{YYYYMM}  (monthly)
    //   counters/sparepart-master                                  (ever-incrementing)
    // Callers may only create a counter at 1 or bump an existing one
    // by exactly +1 — never set it to an arbitrary value — so IDs
    // can be safely minted without opening the door to tampering.
    // ---------------------------------------------------------------

    match /counters/{counterId} {
      allow get: if true;
      // counters/servicecenter-master and counters/technician-master are
      // deliberately NOT listed here: only the Cloud Functions in
      // functions/index.js (which bypass these rules) may write them, so
      // no client can bump or reset the Service Center / Technician Code
      // numbering.
      // The website (no login) only ever uses the enquiry, productreg and
      // publicservice serials; every other counter needs a signed-in user.
      allow create: if ((counterId.matches('^(enquiry|productreg|publicservice)-[0-9]{6}$'))
          || (isSignedIn() && (counterId.matches('^(sparerequest|localpurchase|claim|return|servicejob|centerrequest|dealerorder|dealersale|distributororder|distributorsale|rma)-[0-9]{6}$') || counterId == 'sparepart-master')))
        && request.resource.data.keys().hasOnly(['value'])
        && request.resource.data.value == 1;
      allow update: if ((counterId.matches('^(enquiry|productreg|publicservice)-[0-9]{6}$'))
          || (isSignedIn() && (counterId.matches('^(sparerequest|localpurchase|claim|return|servicejob|centerrequest|dealerorder|dealersale|distributororder|distributorsale|rma)-[0-9]{6}$') || counterId == 'sparepart-master')))
        && request.resource.data.keys().hasOnly(['value'])
        && request.resource.data.value == resource.data.value + 1;
      allow delete: if isAdmin();
    }

    match /contactEnquiries/{enquiryId} {
      allow create: if request.resource.data.keys().hasAll(['ticketId', 'name', 'phone', 'message', 'createdAt'])
        && request.resource.data.ticketId is string
        && request.resource.data.ticketId.matches('^PE-[A-Z]+-[0-9]{8}-[0-9]{4}-[A-Za-z]+$')
        && request.resource.data.name is string
        && request.resource.data.name.size() > 0 && request.resource.data.name.size() <= 100
        && request.resource.data.phone is string
        && request.resource.data.phone.matches('^[6-9][0-9]{9}$')
        && request.resource.data.message is string
        && request.resource.data.message.size() > 0 && request.resource.data.message.size() <= 2000;
      allow read, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // CRM user profiles — each signed-in user's own role record.
    // A user can read their own profile (needed for role checks and
    // for the CRM UI to know what to show them). Only admins can
    // create/change roles — nobody can grant themselves access.
    // ---------------------------------------------------------------

    match /users/{userId} {
      // Technician profiles are also readable by any signed-in staff
      // member — Service Center needs to list and link real
      // technician accounts to their own roster. Service center
      // profiles are readable the same way — a technician needs to
      // read their own linked center's profile to pick up its
      // standard service-charge rate for automatic warranty billing.
      // Staff only (not dealers/distributors — their pages only ever
      // read their own user doc), so a dealer can't pull every
      // technician's and service center's contact/coverage details.
      allow read: if hasAuth() && (request.auth.uid == userId || isAdmin()
        || (isStaff() && (resource.data.role == 'technician' || resource.data.role == 'servicecenter'))
        || (isDistributor() && resource.data.role == 'dealer' && resource.data.get('distributorUid', '') == request.auth.uid));
      // Warehouse is isAdmin() too, but minting or touching a
      // 'superadmin' account is restricted to an actual Super Admin —
      // see isSuperAdmin() above. Without this, Warehouse's own
      // "Import staff accounts" bulk-CSV tab (role column accepts
      // 'superadmin') could be used to self-escalate.
      allow create: if isAdmin() && (request.resource.data.role != 'superadmin' || isSuperAdmin());
      allow delete: if isAdmin();
      allow update: if (isAdmin()
            && (request.resource.data.role != 'superadmin' || isSuperAdmin())
            && (resource.data.role != 'superadmin' || isSuperAdmin()))
        // A user may self-edit their own doc (name, phone, etc.), but
        // never their own role, and never the routing-critical fields
        // (coverage/brand authorization/roster linkage) that the rest
        // of this app treats as admin-only everywhere else — without
        // this deny-list, any signed-in user could grant themselves
        // extra districts, pincodes or brand authorizations just by
        // writing their own /users/{uid} doc directly.
        || (isSignedIn() && request.auth.uid == userId
            && request.resource.data.role == resource.data.role
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
                 ['districtsCovered', 'pincodesCovered', 'brandsAuthorized', 'linkedServiceCenterUid', 'createdAt',
                  'distributionType', 'distributorUid', 'distributorName', 'accountType', 'contractEndDate', 'skills', 'phone10']))
        // A service center (or technician's own account, via isStaff())
        // claiming/releasing a technician onto/off its own roster —
        // this is the ONLY field a staff member may touch on someone
        // else's account, and only to claim an unlinked technician for
        // themselves or release one they already hold. This keeps a
        // technician locked to a single service center: another center
        // can't claim someone who's already linked elsewhere.
        || (isStaff() && resource.data.role == 'technician'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['linkedServiceCenterUid', 'updatedAt'])
            && (
              (!('linkedServiceCenterUid' in resource.data) || resource.data.linkedServiceCenterUid == null)
              && request.resource.data.linkedServiceCenterUid == request.auth.uid
              ||
              resource.data.linkedServiceCenterUid == request.auth.uid
              && request.resource.data.linkedServiceCenterUid == null
            ));
    }

    // ---------------------------------------------------------------
    // Service jobs — a technician may only read/write their OWN jobs
    // (matched by technicianUid), not other technicians'. Admins can
    // see everything, for future dispatch/oversight. This overrides
    // the general staff catch-all below, which would otherwise let
    // any technician read every other technician's job list.
    // ---------------------------------------------------------------

    match /serviceJobs/{jobId} {
      // Distributor read is scoped to only still-open (SLA-clock)
      // statuses — an escalation view needs to see these, but a
      // distributor has no reason to read closed job history.
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.technicianUid == request.auth.uid)
        || (isDistributor() && resource.data.status in
            ['assigned', 'accepted', 'on_the_way', 'at_customer', 'in_progress', 'waiting_spare']);
      // A technician can't write the warranty verdict, charge or billing
      // fields on their own job — the billOnClose_serviceJobs function does.
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.technicianUid == request.auth.uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
              ['warrantyStatus', 'serviceCharge', 'billingType', 'billingStatus', 'billingTotal', 'billedAt', 'billingComputedAt', 'customerFeedback']));
      allow create: if isAdmin()
        || (isSignedIn() && request.resource.data.technicianUid == request.auth.uid
            && !request.resource.data.keys().hasAny(
              ['warrantyStatus', 'serviceCharge', 'billingType', 'billingStatus', 'billingTotal', 'billedAt', 'billingComputedAt', 'customerFeedback']));
      allow delete: if isAdmin();

      // Append-only status/progress log — every status change any
      // portal makes to this job also writes one entry here, so the
      // ticket popup can show a real timeline instead of just the
      // current status. Same broad staff read as everywhere else this
      // ticket's own data is visible; entries are never edited or
      // removed once written.
      // Scoped to the job's own technician (previously any staff member
      // could read, or append entries to, ANY job's log).
      match /statusLog/{logId} {
        allow read, create: if isAdmin()
          || (isSignedIn() && get(/databases/$(database)/documents/serviceJobs/$(jobId)).data.technicianUid == request.auth.uid);
        allow update, delete: if isAdmin();
      }
    }

    // ---------------------------------------------------------------
    // Center requests & center technician roster — scoped to the
    // owning service center's own uid, same pattern as serviceJobs.
    // ---------------------------------------------------------------

    match /centerRequests/{reqId} {
      // Same distributor carve-out as serviceJobs above — open
      // (SLA-clock) tickets only, for the escalation view. Also
      // readable by the roster technician it's assigned to, so their
      // own "My Jobs" page can see center-assigned work.
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.serviceCenterUid == request.auth.uid)
        || (isSignedIn() && resource.data.technicianUid == request.auth.uid)
        || (isDistributor() && resource.data.status in
            ['new', 'assigned', 'accepted', 'on_the_way', 'at_customer', 'in_progress', 'waiting_spare']);
      allow update: if !request.resource.data.diff(resource.data).affectedKeys().hasAny(['intakeWarranty', 'possibleDuplicateOf', 'assignmentRejected', 'scheduleRejected', 'lifecycleRejected', 'billingComputedAt', 'customerFeedback',
            // Billing is decided by the server (billOnClose_* / applyBillingRequest) and
            // claim locking by checkClaim — a browser only files a billingRequest.
            'warrantyStatus', 'serviceCharge', 'sparePartsCost', 'otherCharges', 'billingTotal', 'billingType', 'billingStatus',
            'billedAt', 'claimId', 'claimDocId', 'customerPaymentMethod', 'customerPaymentRef', 'billingRejected', 'billingDecidedAt'])
        && (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['billingRequest'])
            || (resource.data.serviceCenterUid == request.auth.uid
                && request.resource.data.billingRequest.byUid == request.auth.uid
                && request.resource.data.billingRequest.requestedAt == request.time))
        && (isAdmin()
        || (isSignedIn() && resource.data.serviceCenterUid == request.auth.uid)
        // The assigned technician may advance/close their own ticket,
        // but only touch the fields their own workflow writes — never
        // reassign themselves or edit the customer/intake details.
        || (isSignedIn() && resource.data.technicianUid == request.auth.uid
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(
              ['status', 'updatedAt', 'closureCode', 'actionTaken', 'partsUsedNotes', 'closedByUid', 'closedAt',
               'beforePhotos', 'afterPhotos', 'serialNumberPhoto',
               // Warranty verdict, service charge and billing fields are
               // NOT here: the billOnClose_* Cloud Function sets them when
               // a technician completes a ticket.
               ])));
      allow create: if (isAdmin()
        || (isSignedIn() && request.resource.data.serviceCenterUid == request.auth.uid))
        && !request.resource.data.keys().hasAny(['intakeWarranty', 'possibleDuplicateOf', 'assignmentRejected', 'scheduleRejected', 'lifecycleRejected', 'billingComputedAt', 'customerFeedback']);
      allow delete: if isAdmin();

      // Same append-only status/progress log as serviceJobs above —
      // scoped to the ticket's own service center and assigned technician.
      match /statusLog/{logId} {
        allow read, create: if isAdmin()
          || (isSignedIn() && (
                get(/databases/$(database)/documents/centerRequests/$(reqId)).data.serviceCenterUid == request.auth.uid
             || get(/databases/$(database)/documents/centerRequests/$(reqId)).data.technicianUid == request.auth.uid));
        allow update, delete: if isAdmin();
      }
    }

    match /centerTechnicians/{techId} {
      // The roster technician can read their own record too (their own
      // "Full profile" page, and the account-status check at login,
      // both query it by technicianUid) — previously only the owning
      // center and admins could, so neither could work for a technician.
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.serviceCenterUid == request.auth.uid)
        || (isSignedIn() && resource.data.technicianUid == request.auth.uid);
      allow delete: if isAdmin()
        || (isSignedIn() && resource.data.serviceCenterUid == request.auth.uid);
      allow create: if (isAdmin()
            || (isSignedIn() && request.resource.data.serviceCenterUid == request.auth.uid))
        && !('technicianCode' in request.resource.data);
      allow update:
        // Admin / owning center: anything, EXCEPT the Technician Code
        // (TC-0001 …) — issued by a Cloud Function (functions/index.js),
        // never by a client; once set (or while still unset) no client
        // may add, change or remove it.
        if ((isAdmin() || (isSignedIn() && resource.data.serviceCenterUid == request.auth.uid))
            && request.resource.data.get('technicianCode', '') == resource.data.get('technicianCode', ''))
        // The technician themselves: only the personal/address/vehicle
        // fields their own profile page edits, plus APPENDING one leave
        // request (must arrive PENDING — approving is the admin's call)
        // or one document (must arrive unverified).
        || (isSignedIn() && resource.data.technicianUid == request.auth.uid
            && (request.resource.data.diff(resource.data).affectedKeys().hasOnly(
                  ['gender', 'dob', 'altPhone', 'emergencyContactName', 'emergencyContactPhone',
                   'emergencyContactRelation', 'addressLine1', 'addressLine2', 'pincode', 'area',
                   'city', 'taluk', 'district', 'state', 'vehicleInfo', 'updatedAt'])
                || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['leaveRecords'])
                    && request.resource.data.leaveRecords.size() == resource.data.get('leaveRecords', []).size() + 1
                    && request.resource.data.leaveRecords[0:resource.data.get('leaveRecords', []).size()] == resource.data.get('leaveRecords', [])
                    && request.resource.data.leaveRecords[resource.data.get('leaveRecords', []).size()].status == 'PENDING')
                || (request.resource.data.diff(resource.data).affectedKeys().hasOnly(['documents'])
                    && request.resource.data.documents.size() == resource.data.get('documents', []).size() + 1
                    && request.resource.data.documents[0:resource.data.get('documents', []).size()] == resource.data.get('documents', [])
                    && request.resource.data.documents[resource.data.get('documents', []).size()].verified == false)));
    }

    // ---------------------------------------------------------------
    // Dealer collections — each scoped to the owning dealer's own
    // uid, same pattern as service center / technician above. Dealer
    // is NOT in isStaff(), so without these dedicated rules a dealer
    // would have no access to any of their own data at all.
    // ---------------------------------------------------------------

    match /dealerCustomers/{id} {
      allow read, update, delete: if isAdmin()
        || (isSignedIn() && resource.data.dealerUid == request.auth.uid);
      allow create: if isAdmin()
        || (isSignedIn() && request.resource.data.dealerUid == request.auth.uid);
    }

    match /dealerOrders/{id} {
      // A Direct dealer's order is sold and approved by Head Office
      // (Warehouse / Super Admin); a dealer under a distributor buys from
      // that distributor, who approves and fulfils it. Super Admin and
      // Warehouse can still see and act on every order.
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.dealerUid == request.auth.uid)
        || (isDistributor() && resource.data.distributorUid == request.auth.uid);
      allow update: if (isAdmin() && resource.data.get('distributorUid', '') == '' && sellerOrderUpdateOk(resource.data.dealerUid))
        || (isAdmin() && resource.data.get('distributorUid', '') != '' && sellerOrderUpdateOk(''))
        || (isDistributor() && resource.data.get('distributorUid', '') == request.auth.uid && sellerOrderUpdateOk(''))
        || (isSignedIn() && resource.data.dealerUid == request.auth.uid && buyerCancelOk());
      // Only a dealer places a dealer order, with products and quantities
      // only, and the distributor it goes to is the one on the dealer's own
      // account (set by Super Admin/Warehouse), never one they pick.
      allow create: if isSignedIn() && callerRole() == 'dealer'
            && request.resource.data.dealerUid == request.auth.uid
            && request.resource.data.keys().hasOnly(['orderId', 'dealerUid', 'dealerEmail', 'dealerName', 'lines', 'notes', 'status', 'distributorUid', 'distributorName', 'createdAt', 'updatedAt'])
            && newOrderLinesOk()
            && ((get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('distributionType', '') == 'underDistributor'
                 && request.resource.data.get('distributorUid', '') == get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('distributorUid', ''))
              || (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('distributionType', '') != 'underDistributor'
                 && request.resource.data.get('distributorUid', '') == ''));
      allow delete: if isSuperAdmin();
    }

    match /dealerSales/{id} {
      allow read, update, delete: if isAdmin()
        || (isSignedIn() && resource.data.dealerUid == request.auth.uid);
      allow create: if isAdmin()
        || (isSignedIn() && request.resource.data.dealerUid == request.auth.uid);
    }

    // ---------------------------------------------------------------
    // Distributor collections — same self-scoped pattern as Dealer
    // above, kept as its own separate set of collections (not shared
    // with dealerCustomers/dealerOrders/etc.) since a Distributor is
    // a different account type with its own data, even though the
    // portal is built the same way. distributorProductRegistrations
    // is deliberately its own collection too, rather than writing
    // into the shared productRegistrations collection below — that
    // one is read by Super Admin/Warehouse expecting dealerUid/
    // dealerName fields specifically (warranty tracking tied to an
    // actual retail sale to an end customer).
    // ---------------------------------------------------------------

    match /distributorCustomers/{id} {
      allow read, update, delete: if isAdmin()
        || (isSignedIn() && resource.data.distributorUid == request.auth.uid);
      allow create: if isAdmin()
        || (isSignedIn() && request.resource.data.distributorUid == request.auth.uid);
    }

    match /distributorOrders/{id} {
      // A distributor buys from Head Office; Warehouse / Super Admin approve.
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.distributorUid == request.auth.uid);
      allow create: if isDistributor() && request.resource.data.distributorUid == request.auth.uid
            && request.resource.data.keys().hasOnly(['orderId', 'distributorUid', 'distributorEmail', 'distributorName', 'lines', 'notes', 'status', 'createdAt', 'updatedAt'])
            && newOrderLinesOk();
      allow update: if (isAdmin() && sellerOrderUpdateOk(resource.data.distributorUid))
        || (isDistributor() && resource.data.distributorUid == request.auth.uid && buyerCancelOk());
      allow delete: if isSuperAdmin();
    }

    match /distributorSales/{id} {
      allow read, update, delete: if isAdmin()
        || (isSignedIn() && resource.data.distributorUid == request.auth.uid);
      allow create: if isAdmin()
        || (isSignedIn() && request.resource.data.distributorUid == request.auth.uid);
    }

    match /distributorProductRegistrations/{id} {
      allow read, update, delete: if isAdmin()
        || (isSignedIn() && resource.data.distributorUid == request.auth.uid);
      allow create: if isAdmin()
        || (isSignedIn() && request.resource.data.distributorUid == request.auth.uid);
    }

    match /distributorEnquiries/{id} {
      allow read, update, delete: if isAdmin()
        || (isSignedIn() && resource.data.distributorUid == request.auth.uid);
      allow create: if isAdmin()
        || (isSignedIn() && request.resource.data.distributorUid == request.auth.uid);
    }

    match /productRegistrations/{id} {
      // Not public any more: the website's Warranty Check / Track /
      // Book lookups go through the publicLookup function. CRM users
      // read them as before; a customer reads only the registrations
      // made with their own verified phone.
      allow read: if isSignedIn()
        || (isCustomer() && resource.data.customerPhone == myPhone());
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.dealerUid == request.auth.uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(
                 ['warrantyMonths', 'purchaseDate', 'serialNumber', 'dealerUid', 'registrationId', 'createdAt', 'serialCheck']));
      allow create: if (isAdmin()
        || (isSignedIn() && request.resource.data.dealerUid == request.auth.uid)
        || (request.resource.data.source == 'public-site'
            && request.resource.data.keys().hasAll(['registrationId', 'customerName', 'customerPhone', 'product', 'createdAt'])
            && request.resource.data.customerPhone is string
            && request.resource.data.customerPhone.matches('^[6-9][0-9]{9}$')))
        && !('serialCheck' in request.resource.data);
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // Public service requests (from the "Book a Service" flow).
    // Document ID IS the requestId, so Track Service can do a direct
    // get() by ticket number rather than an open query — `allow list`
    // stays admin-only so nobody can enumerate the whole collection.
    // A guessable low-serial ticket ID is a known residual limitation
    // (see index.html comments) — no server-side phone verification
    // is possible without a backend, so treat the ticket ID itself,
    // not the phone, as the actual access boundary.
    // ---------------------------------------------------------------

    match /publicServiceRequests/{requestId} {
      // Reads: CRM users, and the customer who raised it (by verified
      // phone). Anonymous lookups go through publicLookup.
      allow get: if isSignedIn()
        || (isCustomer() && resource.data.customerPhone == myPhone());
      allow list: if isAdmin()
        || (isCustomer() && resource.data.customerPhone == myPhone());
      allow create: if requestId == request.resource.data.requestId
        && request.resource.data.keys().hasAll(['requestId', 'customerName', 'customerPhone', 'status', 'createdAt'])
        && request.resource.data.customerPhone is string
        && request.resource.data.customerPhone.matches('^[6-9][0-9]{9}$')
        // A new website request always starts as 'new' from the public
        // site (it can't open itself as 'closed' or in-warranty), has
        // bounded text, and can't carry the server-only intake fields.
        && request.resource.data.status == 'new'
        && request.resource.data.get('source', '') == 'public-site'
        && request.resource.data.customerName is string
        && request.resource.data.customerName.size() > 0
        && request.resource.data.customerName.size() <= 100
        && request.resource.data.get('address', '').size() <= 300
        && request.resource.data.get('issueDescription', '').size() <= 1000
        && request.resource.data.get('pincode', '').matches('^([0-9]{6})?$')
        && !request.resource.data.keys().hasAny(['intakeWarranty', 'possibleDuplicateOf', 'warrantyStatus', 'routing', 'serviceCenterUid', 'serviceCenterName']);
      allow update, delete: if isAdmin();

      // Status log — admin-only, same as the request itself before
      // it's routed to a Service Center or Technician (who then log
      // against their own serviceJobs/centerRequests doc instead).
      match /statusLog/{logId} {
        allow read, create: if isAdmin();
        allow update, delete: if isAdmin();
      }
    }

    // A narrow, public-safe mirror of a centerRequests/serviceJobs
    // ticket, so a CRM-raised ticket (PE-CR-.../PE-JOB-...) can be
    // looked up on the public Track Service page the same way a
    // website-raised publicServiceRequests ticket already can —
    // without opening the real collections (which carry the
    // customer's address, technician identity, closure notes, etc.)
    // to public query. Keyed by the ticket ID itself, exactly like
    // publicServiceRequests, so a "get" never needs a public list.
    // Only staff (service center/technician/admin) write it, from the
    // app's own ticket-creation and status-change code paths.
    match /publicTicketStatus/{ticketId} {
      allow get: if isSignedIn()
        || (isCustomer() && resource.data.customerPhone == myPhone());
      // Not public any more: the website's Warranty Status check goes
      // through the publicLookup function (narrow fields, rate limited).
      // CRM users and the customer whose verified phone is on the
      // ticket may list it.
      allow list: if isSignedIn()
        || (isCustomer() && resource.data.customerPhone == myPhone());
      allow create, update: if isAdmin() || isStaff();
      allow delete: if isAdmin();
    }

    // Customer feedback, one record per ticket (doc ID = ticket ID).
    // Anyone may create it from the public Track page, but only for a
    // finished ticket whose public mirror carries the same phone number,
    // with a whole-number rating 1-5 and a short comment. It can never
    // be edited afterwards. The processFeedback function then re-checks
    // the real ticket and adds the service center / technician uids,
    // which is what lets them read their own feedback below.
    match /serviceFeedback/{ticketId} {
      allow create: if request.resource.data.keys().hasOnly(['ticketId', 'customerPhone', 'rating', 'comment', 'createdAt'])
        && request.resource.data.ticketId == ticketId
        && request.resource.data.rating is int
        && request.resource.data.rating >= 1 && request.resource.data.rating <= 5
        && request.resource.data.get('comment', '') is string
        && request.resource.data.get('comment', '').size() <= 500
        && request.resource.data.customerPhone is string
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/publicTicketStatus/$(ticketId))
        && get(/databases/$(database)/documents/publicTicketStatus/$(ticketId)).data.status in ['completed', 'verification', 'closed']
        && get(/databases/$(database)/documents/publicTicketStatus/$(ticketId)).data.customerPhone == request.resource.data.customerPhone;
      allow read: if isAdmin()
        || (isSignedIn() && (resource.data.get('serviceCenterUid', null) == request.auth.uid
                             || resource.data.get('technicianUid', null) == request.auth.uid));
      allow update: if false;
      allow delete: if isAdmin();
    }

    // Private trade prices, one doc per seller + buyer + model:
    // priceLists/<seller>_<buyer>_<modelId>. Head Office ('company') prices
    // are set by Super Admin only; a distributor sets prices only for its
    // own dealers. A buyer reads its own prices and the standard price its
    // seller offers everyone of its kind. Warehouse can read all of them.
    match /priceLists/{priceId} {
      allow read: if isAdmin()
        || (isSignedIn() && (resource.data.buyer == request.auth.uid || resource.data.seller == request.auth.uid))
        || (isSignedIn() && resource.data.seller == 'company' && resource.data.buyer == 'default-dealer' && callerRole() == 'dealer')
        || (isDistributor() && resource.data.seller == 'company' && resource.data.buyer == 'default-distributor')
        || (isSignedIn() && resource.data.buyer == 'default' && callerRole() == 'dealer'
            && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.get('distributorUid', '') == resource.data.seller);
      allow create, update: if request.resource.data.keys().hasOnly(['seller', 'buyer', 'modelId', 'price', 'updatedAt', 'updatedBy'])
        && request.resource.data.price is number
        && request.resource.data.price >= 0 && request.resource.data.price <= 100000000
        && priceId == request.resource.data.seller + '_' + request.resource.data.buyer + '_' + request.resource.data.modelId
        && (resource == null || (resource.data.seller == request.resource.data.seller && resource.data.buyer == request.resource.data.buyer))
        && ((isSuperAdmin() && request.resource.data.seller == 'company'
             && (request.resource.data.buyer in ['default-dealer', 'default-distributor']
                 || get(/databases/$(database)/documents/users/$(request.resource.data.buyer)).data.role in ['dealer', 'distributor']))
          || (isDistributor() && request.resource.data.seller == request.auth.uid
             && (request.resource.data.buyer == 'default'
                 || (get(/databases/$(database)/documents/users/$(request.resource.data.buyer)).data.role == 'dealer'
                     && get(/databases/$(database)/documents/users/$(request.resource.data.buyer)).data.get('distributorUid', '') == request.auth.uid))));
      allow delete: if (isSuperAdmin() && resource.data.seller == 'company')
        || (isDistributor() && resource.data.seller == request.auth.uid);
    }

    match /dealerEnquiries/{id} {
      allow read, update, delete: if isAdmin()
        || (isSignedIn() && resource.data.dealerUid == request.auth.uid);
      allow create: if isAdmin()
        || (isSignedIn() && request.resource.data.dealerUid == request.auth.uid);
    }

    // Product catalog — readable by anyone signed in (dealers browse
    // it), writable only by Warehouse / Super Admin. Empty until
    // the Product Management module populates it.
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // Product categories — the real Category Master. Public read
    // (the brand microsites need this unauthenticated, same as
    // brands/siteContent); only admins can create/edit. A lightweight
    // per-category change log lives alongside it (categoryHistory) —
    // scoped to this one feature, not the general cross-cutting audit
    // log the project doesn't have yet.
    // ---------------------------------------------------------------

    match /productCategories/{categoryId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // Product Models / SKUs — each model belongs to a parent product
    // (productId) and carries brandId denormalized for easy querying.
    // Public read (same reasoning as products/categories), admin write.
    // ---------------------------------------------------------------

    match /productModels/{modelId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // Warranty Plans — a plan can cover multiple components with
    // different durations (e.g. Washing Machine: full product 1yr,
    // spin motor 2yr, wash motor 5yr). Public read, admin write.
    // ---------------------------------------------------------------

    match /warrantyPlans/{planId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // Dynamic product attributes — configurable spec fields per
    // category (e.g. Television: Screen Size, Resolution...). The
    // Model/SKU form loads these live based on the selected
    // product's category. Public read, admin write.
    // ---------------------------------------------------------------

    match /productAttributes/{attrId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    match /categoryHistory/{entryId} {
      allow read: if isStaff();
      allow create: if isAdmin();
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------
    // Claims — Warehouse (isAdmin) manages the full pipeline for
    // every claim. A technician or service center may create their
    // own claim and read only their own (matched by claimantUid) —
    // they cannot verify/settle/reject their own claims.
    // ---------------------------------------------------------------

    match /claims/{claimId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.claimantUid == request.auth.uid);
      // Filed as 'submitted' with no server fields. A claim is either built
      // from wallet credits / tickets (the checkClaim function locks them
      // to it) or free-form — which needs a claim type and a bill photo
      // unless Head Office files it.
      allow create: if isSignedIn()
        && request.resource.data.get('status', '') == 'submitted'
        && (request.resource.data.get('amount', null) == null
            || (request.resource.data.amount is number && request.resource.data.amount >= 0 && request.resource.data.amount <= 10000000))
        && !request.resource.data.keys().hasAny(['claimCheck', 'lock', 'history', 'approvedAmount', 'verifiedByUid', 'verifiedAt',
             'rejectReason', 'rejectedByUid', 'paidAt', 'paidByUid', 'paymentMethod', 'paymentRef', 'paidDate'])
        && (isAdmin()
            || (request.resource.data.claimantUid == request.auth.uid
                && request.resource.data.claimantType == callerRole()
                && request.resource.data.amount is number && request.resource.data.amount > 0
                && ((request.resource.data.get('walletTxnIds', null) is list && request.resource.data.walletTxnIds.size() >= 1 && request.resource.data.walletTxnIds.size() <= 50)
                    || (request.resource.data.get('ticketIds', null) is list && request.resource.data.ticketIds.size() >= 1 && request.resource.data.ticketIds.size() <= 50)
                    || (request.resource.data.get('claimType', '') in ['travel', 'local_purchase', 'tools', 'other']
                        && request.resource.data.get('attachmentUrl', '') is string
                        && request.resource.data.get('attachmentUrl', '').size() > 10))));
      allow update: if
        // Warehouse (or Super Admin) verifies an approved amount — never
        // more than claimed, nor more than the locked items add up to.
        (isAdmin() && resource.data.status == 'submitted' && request.resource.data.status == 'verified'
          && (resource.data.get('lock', {}).get('status', '') in ['locked', 'manual']
              || (!('lock' in resource.data) && 'claimCheck' in resource.data))
          && request.resource.data.approvedAmount is number && request.resource.data.approvedAmount > 0
          && (resource.data.get('amount', null) == null || request.resource.data.approvedAmount <= resource.data.amount)
          && (resource.data.get('lock', {}).get('status', '') != 'locked' || request.resource.data.approvedAmount <= resource.data.claimCheck.verified)
          && request.resource.data.verifiedByUid == request.auth.uid
          && request.resource.data.verifiedAt == request.time
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'approvedAmount', 'verifiedByUid', 'verifiedByEmail', 'verifiedAt', 'verifyNote', 'updatedAt']))
        // Rejected before payment, with a reason (the items are released).
        || (isAdmin() && resource.data.status in ['submitted', 'verified'] && request.resource.data.status == 'rejected'
          && request.resource.data.rejectReason is string && request.resource.data.rejectReason.size() >= 3
          && request.resource.data.rejectedByUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'rejectReason', 'rejectedByUid', 'rejectedAt', 'updatedAt']))
        // Only Super Admin pays, and not a claim they verified themselves;
        // the payment record (approved amount) is written by the server.
        || (isSuperAdmin() && resource.data.status == 'verified' && request.resource.data.status == 'settled'
          && resource.data.get('verifiedByUid', '') != request.auth.uid
          && request.resource.data.paidByUid == request.auth.uid
          && request.resource.data.paidAt == request.time
          && request.resource.data.paymentMethod is string && request.resource.data.paymentMethod.size() > 0
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'paidByUid', 'paidByEmail', 'paidAt', 'paymentMethod', 'paymentRef', 'paidDate', 'updatedAt']));
    }

    // ---------------------------------------------------------------
    // Inventory — scoped the same way the writes below already are:
    // a Service Center/Technician reads only their OWN stock doc,
    // Warehouse/Super Admin read everything. (Previously isStaff()
    // let any Service Center or Technician read every OTHER center's
    // and technician's stock levels directly via the SDK — the real
    // UI never queries unscoped, so this closes that without changing
    // any page's behavior.)
    // ---------------------------------------------------------------

    match /inventory/{invId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.location == 'technician' && resource.data.technicianUid == request.auth.uid)
        || (isSignedIn() && resource.data.location == 'servicecenter' && resource.data.serviceCenterUid == request.auth.uid);
      // Helper checks (inlined, since rules can't share functions across
      // a get()'s field access easily): a technician<->center transfer
      // is authorized either by the linkedServiceCenterUid stamp on the
      // technician's own users doc, OR — more robustly, since that
      // stamp is only set going forward and isn't backfilled for
      // technicians linked before that feature existed — by the real
      // open centerRequests ticket (lastSourceJobId) the transfer is
      // actually against, cross-checked for both the center and the
      // technician on that exact ticket.
      // Only Warehouse / Super Admin write stock directly (and never below
      // zero). A service center or technician changes its own stock by
      // filing a stockOps request, applied by the applySparesOp function
      // together with its stockMovements ledger line.
      allow create, update: if isAdmin()
        && request.resource.data.get('quantity', 0) is int
        && request.resource.data.get('quantity', 0) >= 0
        // Head Office stock only goes down without Super Admin's approval
        // when it is dispatched against a spare request, with the transfer
        // ledger line written in the same transaction. Write-offs and count
        // corrections go through a 'stock_reduction' change request.
        && (isSuperAdmin() || resource == null || resource.data.location != 'warehouse'
            || request.resource.data.quantity >= resource.data.get('quantity', 0)
            || (request.resource.data.get('lastMoveId', '') is string && request.resource.data.get('lastMoveId', '') != ''
                && getAfter(/databases/$(database)/documents/stockMovements/$(request.resource.data.lastMoveId)).data.type == 'transfer'
                && getAfter(/databases/$(database)/documents/stockMovements/$(request.resource.data.lastMoveId)).data.get('sourceRequestId', '') != ''
                && getAfter(/databases/$(database)/documents/stockMovements/$(request.resource.data.lastMoveId)).data.quantity
                     == resource.data.get('quantity', 0) - request.resource.data.quantity));
      allow delete: if isAdmin();
    }

    match /technicianAvailability/{uid} {
      allow read: if isStaff();
      allow create: if isAdmin()
        || (isSignedIn() && request.auth.uid == uid && !('suspended' in request.resource.data));
      allow update: if isAdmin()
        || (isSignedIn() && request.auth.uid == uid
            && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['suspended']));
    }

    // ---------------------------------------------------------------
    // Warehouse operational collections. Master data (spare parts) is
    // staff-readable but admin-only to edit. Transactional collections
    // (movements, requests, purchases, returns) are staff-readable for
    // company-wide oversight, but writes are admin-only EXCEPT where a
    // specific role creates its own tagged record (a technician's or
    // service center's own stock movement, or a service center's own
    // return) — those match the same owner-tag pattern used above.
    // ---------------------------------------------------------------

    match /spareParts/{partId} {
      allow read: if isStaff();
      allow create, delete: if isAdmin();
      // Warehouse edits everything except an existing part's price, which
      // goes through a change request that only Super Admin can approve.
      allow update: if isSuperAdmin()
        || (isAdmin() && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['price']));
    }

    // Serial number master — the serials Pushpak has actually
    // manufactured/stocked per model, bulk-loaded from Master Data.
    // Doc ID is the serial number itself, so a re-upload naturally
    // de-dupes instead of creating repeats. Admin-only for now, same
    // as spareParts/products — nothing else reads it yet (see Master
    // Data notes for the planned registration-validation use).
    match /serialNumbers/{serial} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    match /stockMovements/{moveId} {
      // Scoped the same way create already is — Warehouse/Super Admin
      // see every movement, a Service Center/Technician only their own.
      // (isStaff() previously let any of them read every OTHER center's
      // and technician's stock movement history company-wide.)
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.technicianUid == request.auth.uid)
        || (isSignedIn() && resource.data.serviceCenterUid == request.auth.uid);
      // Centers and technicians no longer write ledger lines themselves —
      // applySparesOp writes them with the stock change.
      allow create: if isAdmin() && request.resource.data.createdAt == request.time;
      // The movement ledger is append-only: only Super Admin may correct it.
      allow update, delete: if isSuperAdmin();
    }

    // A service center's or technician's request to change its own spare
    // stock (see functions/spares.js). Filed by them, applied or refused by
    // the applySparesOp function; an 'add stock' request waits for
    // Warehouse / Super Admin to approve or decline it.
    match /stockOps/{opId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.byUid == request.auth.uid);
      allow create: if isSignedIn() && callerRole() in ['servicecenter', 'technician']
        && request.resource.data.byUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.type in ['consume', 'transfer_to_technician', 'draw_from_center', 'remove', 'send_back', 'add_request']
        && request.resource.data.keys().hasOnly(['type', 'byUid', 'byEmail', 'lines', 'job', 'techUid', 'reason', 'spareRequestId', 'status', 'createdAt'])
        && request.resource.data.lines is list
        && request.resource.data.lines.size() >= 1 && request.resource.data.lines.size() <= 20
        && request.resource.data.get('reason', '') is string && request.resource.data.get('reason', '').size() <= 300;
      allow update: if isAdmin()
        && resource.data.status == 'awaiting_approval'
        && request.resource.data.status in ['approved', 'declined']
        && request.resource.data.decidedByUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'decidedByUid', 'decidedByEmail', 'decidedAt', 'decisionNote']);
    }

    match /spareRequests/{reqId} {
      // Scoped to the requester, plus the one cross-reference case the
      // update rule below already has to handle: a Service Center can
      // dispatch a spare request on behalf of one of its OWN roster
      // technicians (requestedByUid is the center's uid, not theirs),
      // and that technician still needs to read it via their own job.
      // (isStaff() previously let any Service Center/Technician read
      // every OTHER center's and technician's spare requests company-
      // wide — real UI queries are always scoped like this already.)
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.requestedByUid == request.auth.uid)
        || (isSignedIn() && resource.data.sourceJobCollection == 'centerRequests'
            && get(/databases/$(database)/documents/centerRequests/$(resource.data.sourceJobId)).data.technicianUid == request.auth.uid);
      // Technicians request spares directly from Diagnosis, tagged
      // with their own uid — Warehouse/Super Admin can also create
      // requests on a center's behalf as before. Advancing a request
      // through the pipeline (approved/picking/dispatched/etc.) stays
      // admin-only — a technician can ask for a part, not move it
      // through the warehouse themselves.
      // A non-admin request always starts as 'new' (or 'fulfilled_by_center'
      // when a center/technician issues from its own shelf) — never
      // pre-dispatched or pre-received — with no dispatch/receipt fields
      // and a sane quantity.
      allow create: if isAdmin()
        || (isSignedIn() && request.resource.data.requestedByUid == request.auth.uid
            && request.resource.data.get('status', '') in ['new', 'fulfilled_by_center']
            && !request.resource.data.keys().hasAny(['transport', 'dispatchedQty', 'receivedAt', 'consumedAt', 'consumedQty', 'pipelineRejected'])
            && request.resource.data.quantity is number
            && request.resource.data.quantity >= 1
            && request.resource.data.quantity <= 1000);
      // Warehouse/Super Admin can move a request through every stage.
      // The center/technician that raised it can additionally confirm
      // receipt themselves — but only that one transition (dispatched or
      // in-transit -> received), so they can't otherwise edit their own
      // request's status, quantity, item or transport details.
      allow update: if isAdmin()
        || (isStaff() && resource.data.requestedByUid == request.auth.uid
            && resource.data.status in ['dispatched', 'intransit']
            && request.resource.data.status == 'received'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'receivedAt', 'updatedAt']))
        // Marking a received (or already center-fulfilled) part as
        // actually installed on the job — only the consumedAt/
        // consumedQty/updatedAt fields, only once, and only by the
        // technician this request's own ticket is actually assigned
        // to (covers both a technician's own request AND one a
        // service center dispatched on their behalf, where
        // requestedByUid is the center, not the technician).
        || (isSignedIn() && resource.data.status in ['received', 'fulfilled_by_center']
            && !('consumedAt' in resource.data)
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['consumedAt', 'consumedQty', 'updatedAt'])
            && (resource.data.requestedByUid == request.auth.uid
                || (resource.data.sourceJobCollection == 'centerRequests'
                    && get(/databases/$(database)/documents/centerRequests/$(resource.data.sourceJobId)).data.technicianUid == request.auth.uid)));
      allow delete: if isAdmin();
    }

    match /localPurchases/{lpId} {
      // Financial reimbursement records — Warehouse/Super Admin only.
      // Neither Service Center nor Technician dashboards read this
      // collection at all, so isStaff() was pure unnecessary exposure
      // of every center's reimbursement claims to every other center.
      allow read: if isAdmin();
      allow write: if isAdmin();
    }

    match /returns/{returnId} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.serviceCenterUid == request.auth.uid)
        || (isSignedIn() && resource.data.technicianUid == request.auth.uid);
      // Returns are opened by the server (a part used on a job, or stock
      // sent back) or by Head Office. A center's only move is to send its
      // pending defectives to Head Office — its monthly batch.
      allow create: if isAdmin();
      allow update: if isAdmin()
        || (isSignedIn() && resource.data.serviceCenterUid == request.auth.uid
            && resource.data.status in ['sent_to_center', 'awaiting_return']
            && request.resource.data.status == 'requested'
            && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'updatedAt', 'batch']));
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // Service charge rates — the rate CARD that decides what a
    // technician's wallet gets credited for an in-warranty job,
    // keyed by product category + service type (repair/installation).
    // Never set by a technician. Head Office owns the 'default' scope
    // (used when a center has no override); each service center may
    // only create/edit its OWN 'center'-scoped override rows, tagged
    // with its own uid.
    // ---------------------------------------------------------------

    match /serviceChargeRates/{rateId} {
      // 'default' rows are the shared Head Office rate card — fine for
      // any staff to see. A 'center' override row is that one center's
      // own commercial term, so it's scoped the same way the writes
      // below already are. (isStaff() previously let any center read
      // every OTHER center's custom rate overrides.)
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.scope == 'default')
        || (isSignedIn() && resource.data.scope == 'center' && resource.data.serviceCenterUid == request.auth.uid);
      // Only Head Office writes rates directly. A center's own rate change
      // is a changeRequests 'center_rate' request that Super Admin
      // approves (the payout depends on it); the server then writes it.
      allow create, update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // Wallet transactions — a technician's running unclaimed balance,
    // auto-credited at job closure when a job turns out to be
    // in-warranty (the service center's standard service-charge rate
    // for that job). The technician later bundles their own unclaimed
    // entries into a claim, exactly like a service center does with
    // its own ready-to-claim tickets.
    // ---------------------------------------------------------------

    match /walletTransactions/{txnId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.technicianUid == request.auth.uid);
      // Credits are issued by the billOnClose_* Cloud Functions (one per
      // job, amount from the rate card) — never by a technician's browser.
      allow create: if isAdmin();
      // The technician may only flip their own still-unclaimed entry to
      // 'claimed' (stamping which claim it went into) — nothing else on
      // the record is theirs to touch.
      // Locking a credit into a claim (and releasing / paying it) is done
      // by the checkClaim / claimUpdated functions, not by any browser.
      allow update: if false;
      allow delete: if isAdmin();
    }

    match /rmaRequests/{rmaId} {
      // Warehouse / Super Admin raise and approve RMAs. Dispatching the
      // replacement and receiving the defective unit are done by the
      // rmaUpdated function (it checks the serial against stock) — a
      // browser only asks for them.
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.status == 'requested'
        && !request.resource.data.keys().hasAny(['replacementSerial', 'dispatch', 'history', 'rmaRejected', 'dispatchProcessedFor',
             'defectiveUnitId', 'defectiveReceivedAt', 'replacementRegistrationId', 'warrantyCarried', 'brandReturnId']);
      allow update: if isAdmin() && (
        (resource.data.status == 'requested' && request.resource.data.status == 'approved'
          && request.resource.data.modelId is string && request.resource.data.modelId.size() > 0
          && request.resource.data.approvedByUid == request.auth.uid
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'modelId', 'modelLabel', 'approvedByUid', 'approvedByEmail', 'approvedAt', 'approveNote', 'updatedAt']))
        || (resource.data.status in ['requested', 'approved'] && request.resource.data.status == 'rejected'
          && request.resource.data.rejectReason is string && request.resource.data.rejectReason.size() >= 3
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'rejectReason', 'rejectedByUid', 'updatedAt']))
        || (resource.data.status == 'approved' && request.resource.data.status == 'approved'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['dispatchRequest', 'updatedAt'])
          && request.resource.data.dispatchRequest.byUid == request.auth.uid
          && request.resource.data.dispatchRequest.requestedAt == request.time)
        || (resource.data.status == 'replacement_dispatched' && request.resource.data.status == 'replacement_dispatched'
          && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['receiveRequest', 'updatedAt'])
          && request.resource.data.receiveRequest.byUid == request.auth.uid
          && request.resource.data.receiveRequest.requestedAt == request.time));
    }

    // Shipments of defective units / spares back to the brand (functions:
    // processBrandReturn). Head Office files one as 'pending'; afterwards
    // it can only add the brand's credit notes and close it.
    match /brandReturns/{brId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.status == 'pending'
        && request.resource.data.keys().hasOnly(['brand', 'unitSerials', 'spareReturnIds', 'courier', 'docket', 'sentOn', 'notes', 'createdByUid', 'createdByEmail', 'createdAt', 'status'])
        && request.resource.data.unitSerials is list && request.resource.data.spareReturnIds is list
        && request.resource.data.unitSerials.size() + request.resource.data.spareReturnIds.size() >= 1
        && request.resource.data.unitSerials.size() + request.resource.data.spareReturnIds.size() <= 300
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdAt == request.time;
      allow update: if isAdmin()
        && resource.data.status == 'sent'
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['creditNotes', 'status', 'closedNote', 'closedByUid', 'updatedAt'])
        && request.resource.data.get('creditNotes', []) is list
        && request.resource.data.status in ['sent', 'closed'];
    }

    match /messageTemplates/{templateId} {
      allow read: if isStaff();
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // In-app notifications — targeted either at a specific user
    // (recipientType 'uid') or an entire role (recipientType 'role').
    // Create is intentionally open (validated) because the public
    // contact form — unauthenticated — needs to notify Super Admin
    // of a new enquiry; read/update are restricted to the actual
    // recipient. This is the achievable slice of "Communication"
    // without a real WhatsApp/SMS/Email provider connected (see
    // messageTemplates above for the rest of that honest scoping).
    // ---------------------------------------------------------------

    match /notifications/{notifId} {
      allow read, update: if isSignedIn() && (
        isAdmin()
        || (resource.data.recipientType == 'uid' && resource.data.recipientValue == request.auth.uid)
        || (resource.data.recipientType == 'role' && resource.data.recipientValue == callerRole())
      );
      // An anonymous visitor (the public enquiry form) may only raise the
      // one notification that form sends — to Super Admin, unread, with
      // bounded text — so the open endpoint can't be used to spam other
      // roles or individual users. Signed-in users keep the general form.
      allow create: if request.resource.data.keys().hasAll(['recipientType', 'recipientValue', 'title', 'message', 'read', 'createdAt'])
        && request.resource.data.title is string && request.resource.data.title.size() <= 200
        && request.resource.data.message is string && request.resource.data.message.size() <= 2000
        && (isSignedIn()
            || (request.resource.data.recipientType == 'role'
                && request.resource.data.recipientValue == 'superadmin'
                && request.resource.data.read == false));
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // Payments — a real settlement record (method, reference, paid
    // date) created whenever Warehouse marks a claim "Settled" or a
    // local purchase "Reimbursed", instead of that being a bare
    // status flip with no payment trail.
    // ---------------------------------------------------------------

    match /payments/{paymentId} {
      // Settlement records. A claim's payment is written by the
      // claimUpdated function when Super Admin settles it (amount = the
      // verified amount); Warehouse / Super Admin still record local
      // purchase reimbursements here directly.
      allow read: if isAdmin();
      allow create: if isAdmin() && request.resource.data.get('sourceType', '') != 'claim';
      allow update, delete: if isSuperAdmin() && resource.data.get('sourceType', '') != 'claim';
    }

    match /settings/{settingId} {
      allow read: if isStaff();
      // The company GST profile printed on every invoice is Super Admin's.
      allow write: if isAdmin() && (settingId != 'companyProfile' || isSuperAdmin());
    }

    // ---------------------------------------------------------------
    // Trade finance (functions/index.js: createInvoice, cancelInvoice,
    // applyTradePayment). Invoices, ledger lines and account balances are
    // written only by those functions. Super Admin sets each account's
    // credit limit and payment terms; Warehouse / Super Admin record
    // payments received. A dealer or distributor reads only its own.
    // ---------------------------------------------------------------
    // Finished-goods stock (functions/index.js: processStockReceipt,
    // reserveForOrder, processDispatch, processDelivery). Stock levels,
    // unit serials and the movement log are server-only. Warehouse /
    // Super Admin receive stock by filing a receipt with one serial per
    // unit; a distributor sees its own stock and the units it holds.
    match /productStock/{stockId} {
      allow read: if isAdmin()
        || (isDistributor() && resource.data.location == 'dist_' + request.auth.uid);
    }
    match /unitSerials/{serial} {
      allow read: if isAdmin()
        || (isSignedIn() && resource.data.get('soldToUid', '') == request.auth.uid)
        || (isDistributor() && resource.data.location == 'dist_' + request.auth.uid);
    }
    match /productMovements/{moveId} {
      allow read: if isAdmin();
    }
    match /stockReceipts/{receiptId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['modelId', 'modelLabel', 'serials', 'supplier', 'invoiceRef', 'receivedOn', 'notes', 'createdByUid', 'createdByEmail', 'createdAt', 'brandReturnId'])
        && request.resource.data.modelId is string
        && request.resource.data.serials is list
        && request.resource.data.serials.size() >= 1 && request.resource.data.serials.size() <= 400
        && request.resource.data.createdByUid == request.auth.uid
        && request.resource.data.createdAt == request.time;
    }

    match /tradeAccounts/{uid} {
      allow read: if isAdmin() || (isSignedIn() && request.auth.uid == uid);
      allow create: if isSuperAdmin()
        && request.resource.data.keys().hasOnly(['creditLimit', 'paymentTermsDays', 'stateCode', 'notes', 'updatedAt', 'updatedBy'])
        && accountTermsOk();
      allow update: if isSuperAdmin()
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['creditLimit', 'paymentTermsDays', 'stateCode', 'notes', 'updatedAt', 'updatedBy'])
        && accountTermsOk();
      function accountTermsOk() {
        return request.resource.data.get('creditLimit', 0) is number
        && request.resource.data.get('creditLimit', 0) >= 0 && request.resource.data.get('creditLimit', 0) <= 1000000000
        && request.resource.data.get('paymentTermsDays', 30) is int
        && request.resource.data.get('paymentTermsDays', 30) >= 0 && request.resource.data.get('paymentTermsDays', 30) <= 365;
      }
    }
    match /invoices/{invoiceId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.buyerUid == request.auth.uid);
    }
    match /ledgerEntries/{entryId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.accountUid == request.auth.uid);
    }
    match /tradePayments/{paymentId} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.accountUid == request.auth.uid);
      allow create: if isAdmin()
        && request.resource.data.keys().hasOnly(['accountUid', 'accountName', 'amount', 'mode', 'reference', 'receivedOn', 'notes', 'recordedByUid', 'recordedByEmail', 'createdAt'])
        && request.resource.data.accountUid is string
        && request.resource.data.amount is number && request.resource.data.amount > 0 && request.resource.data.amount <= 1000000000
        && request.resource.data.recordedByUid == request.auth.uid
        && request.resource.data.createdAt == request.time
        && exists(/databases/$(database)/documents/users/$(request.resource.data.accountUid));
    }

    // ---------------------------------------------------------------
    // Audit logs — scoped to the highest-value actions (privilege
    // changes and financial settlements/status changes), not every
    // write across the CRM. Instrumenting literally everything would
    // be a much bigger cross-cutting change; this covers what an
    // audit trail is for in practice: who changed a role, who
    // approved a payment, who changed an RMA's status, and when.
    // Admin-only read; writes only ever come from admin-triggered
    // flows (see the corresponding action in each dashboard).
    // ---------------------------------------------------------------

    // Entries written from the dashboards must name the real caller:
    // performedByUid / performedBy are pinned to the signed-in account,
    // and createdAt to the server clock, so one admin cannot log an
    // action as another or backdate it. Privilege and status changes
    // are ALSO logged server-side (functions/index.js audit* triggers),
    // which no client can forge or skip.
    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isAdmin()
        && request.resource.data.performedByUid == request.auth.uid
        && request.resource.data.performedBy == request.auth.token.email
        && request.resource.data.createdAt == request.time
        && request.resource.data.get('source', '') != 'server';
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------
    // Change requests — a "major change" Warehouse submitted (right
    // now: a price edit on an existing spare part) that sits pending
    // until Super Admin reviews it. Both roles count as isAdmin(), so
    // this is the one place that draws a real line between them:
    // only an actual Super Admin (not Warehouse) can move a request
    // out of "pending" — that's the approval itself.
    // ---------------------------------------------------------------

    // One approval queue (functions: applyChangeRequest). Filed by the
    // person who wants the change; decided by Super Admin — never by the
    // requester; applied by the server from the request's own payload.
    match /changeRequests/{id} {
      allow read: if isAdmin() || (isSignedIn() && resource.data.requestedByUid == request.auth.uid);
      allow create: if isSignedIn()
        && request.resource.data.requestedByUid == request.auth.uid
        && request.resource.data.status == 'pending'
        && request.resource.data.createdAt == request.time
        && request.resource.data.payload is map
        && !request.resource.data.keys().hasAny(['appliedAt', 'applyError', 'reviewedBy', 'reviewedByUid', 'reviewedAt', 'reviewNote'])
        && ((isAdmin() && request.resource.data.kind == 'spare_price'
              && request.resource.data.targetId is string
              && request.resource.data.payload.keys().hasOnly(['price'])
              && (request.resource.data.payload.price == null || request.resource.data.payload.price is number))
          || (isAdmin() && request.resource.data.kind == 'stock_reduction'
              && request.resource.data.payload.keys().hasOnly(['partId', 'qty', 'reason', 'mode'])
              && request.resource.data.payload.qty is int && request.resource.data.payload.qty >= 1)
          || (callerRole() == 'servicecenter' && request.resource.data.kind == 'center_rate'
              && request.resource.data.payload.keys().hasOnly(['rates'])
              && request.resource.data.payload.rates is list
              && request.resource.data.payload.rates.size() >= 1 && request.resource.data.payload.rates.size() <= 200));
      allow update: if isSuperAdmin()
        && resource.data.status == 'pending'
        && request.resource.data.status in ['approved', 'rejected']
        && resource.data.requestedByUid != request.auth.uid
        && request.resource.data.reviewedByUid == request.auth.uid
        && request.resource.data.diff(resource.data).affectedKeys().hasOnly(['status', 'reviewedBy', 'reviewedByUid', 'reviewedAt', 'reviewNote']);
      // The requester may withdraw a request nobody has decided yet.
      allow delete: if isSuperAdmin()
        || (isSignedIn() && resource.data.requestedByUid == request.auth.uid && resource.data.status == 'pending');
    }

    // ---------------------------------------------------------------
    // Pincode master — the territory hierarchy (PIN → City/Taluk/
    // District/State) that Service Center coverage and Routing
    // resolve against. Public read: the "serviceability check" on
    // the public site (checking if a PIN is covered before a
    // customer submits a request) needs this unauthenticated.
    // ---------------------------------------------------------------

    match /pincodes/{pin} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // SLA rules — territory/service-type-aware thresholds, replacing
    // the fixed 24h/48h default. Staff-readable (so Warehouse/Service
    // Center understand what's being measured against), admin-only
    // to configure.
    // ---------------------------------------------------------------

    match /slaRules/{ruleId} {
      allow read: if isStaff() || isDistributor();
      allow write: if isAdmin();
    }

    // ---------------------------------------------------------------
    // SLA escalations — a Distributor's note/nudge raised against a
    // breached service ticket in their coverage area. Kept as its own
    // collection rather than writing onto the ticket doc itself, so a
    // Distributor never gets write access to serviceJobs/centerRequests
    // (they stay read-only there, scoped to open tickets — see above).
    // ---------------------------------------------------------------

    match /slaEscalations/{id} {
      allow read: if isAdmin() || isStaff()
        || (isDistributor() && resource.data.distributorUid == request.auth.uid);
      allow create: if isAdmin()
        || (isDistributor() && request.resource.data.distributorUid == request.auth.uid);
      allow update, delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // Service Center Master profile — doc id IS the owning Service
    // Center's own uid, same self-uid-as-doc-id pattern as
    // technicianAvailability above. The Service Center reads/writes
    // only its own doc (including the very first auto-create on
    // first visit to "Full profile"); Super Admin/Warehouse can
    // read/write any center's doc for the admin-side Full Profile
    // view and edits.
    // ---------------------------------------------------------------

    match /serviceCenterProfiles/{uid} {
      allow read: if isAdmin()
        || (isSignedIn() && request.auth.uid == uid);
      // The Service Center Code (SC-0001 …) is issued by a Cloud Function
      // (functions/index.js), never by a client: a profile is created
      // without one, and once the function has set it, no client — the
      // center or an admin — may add, change or remove it.
      allow create: if (isAdmin()
          || (isSignedIn() && request.auth.uid == uid
              && !request.resource.data.keys().hasAny(['status', 'brandAuthorizations', 'approval', 'documents'])))
        && !('serviceCenterCode' in request.resource.data);
      // A center edits its own profile, but not the fields Super Admin
      // decides: its status (which routing checks), brand authorizations
      // and the approval record. Document verification is guarded by the
      // guardServiceCenterProfile function (rules can't compare arrays
      // element by element).
      allow update: if (isAdmin()
          || (isSignedIn() && request.auth.uid == uid
              && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['status', 'brandAuthorizations', 'approval'])))
        && request.resource.data.get('serviceCenterCode', '') == resource.data.get('serviceCenterCode', '');
      allow delete: if isAdmin();
    }

    // ---------------------------------------------------------------
    // Timeline / activity logs — append-only, immutable, same pattern
    // as categoryHistory/auditLogs above. Staff-wide read (so the
    // owning center/technician, and any admin, can see the log);
    // update and delete are never allowed, preserving the immutable
    // history.
    //
    // technicianTimeline is tagged with technicianDocId, which is the
    // centerTechnicians document's own auto-generated id — NOT the
    // technician's auth uid (centerTechnicians docs are addDoc()'d
    // with a random id; the owning technician is recorded separately
    // in that doc's technicianUid field). So a self-service create has
    // to be verified with a lookup rather than a direct uid match.
    // ---------------------------------------------------------------

    match /technicianTimeline/{entryId} {
      allow read: if isStaff();
      allow create: if isAdmin()
        || (isSignedIn()
            && get(/databases/$(database)/documents/centerTechnicians/$(request.resource.data.technicianDocId)).data.technicianUid == request.auth.uid);
      allow update, delete: if false;
    }

    match /serviceCenterTimeline/{entryId} {
      allow read: if isStaff();
      allow create: if isAdmin()
        || (isSignedIn() && request.resource.data.centerDocId == request.auth.uid);
      allow update, delete: if false;
    }

    // ---------------------------------------------------------------
    // Deny by default. Every collection actually used by the app has
    // an explicit rule above — this is a real security boundary, not
    // a temporary placeholder. If a new collection is added later, it
    // needs its own rule block; it will NOT fall through to broad
    // staff access.
    // ---------------------------------------------------------------

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
